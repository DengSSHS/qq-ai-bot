# ─────────────────────────────────────────────────────────────
# 鲸鲸 QQ 机器人 · 部署参数
# 复制成 deploy.env 再填：cp deploy.env.example deploy.env
# 只填带【必填】的，其余留空会自动生成
# ─────────────────────────────────────────────────────────────

# 【必填】机器人自己的 QQ 号（要能扫码登录，建议用小号）
BOT_QQ=

# 【必填】主人（管理员）的 QQ 号。只有这个号能私聊下指令。
# 需要多个就用 YAML 列表写进 cordis.patch.yml 的 allowFrom / adminUsers
OWNER_QQ=

# 【必填】模型线路。任何 OpenAI 兼容接口都行。
# DeepSeek 官方： https://api.deepseek.com         模型 deepseek-chat
# 硅基流动：      https://api.siliconflow.cn/v1    模型 deepseek-ai/DeepSeek-V3
# 通义/千问平台： https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 说明：这个地址只写进转发层的 LLM_UPSTREAM，DSH 自己永远指向 127.0.0.1:8890


# 【必填】模型 API Key（只写 key 本身，不要带 "Bearer "）
LLM_API_KEY=

# 可选：机器人怎么称呼你（不填就用「主人」）
OWNER_NICK=

# 人设：三个选项，默认第一个
#   builtin   = 用包里那份现成的（136 行，一个鲸鱼娘；可以直接用，也可以之后改）
#   generated = 按提示词引导生成 —— AI 会问你：名字、性格、怎么称呼你、有什么口癖或特别在意的事
#   custom    = 完全自己输入 —— 你自己写全文，或用 PERSONA_FILE 指向一个 .md 文件
PERSONA_MODE=builtin

# custom 模式下可选：人设文件路径（不填就让 AI 把全文写进去）
# PERSONA_FILE=/root/my-persona.md

# 可选：角色名（AI 生成人设时用；留空则由 AI 问你）
BOT_NAME=

# 以下留空自动随机生成（十六进制 32 位）
WS_TOKEN=
NAPCAT_WEBUI_TOKEN=

# 可选：搜索后端（默认走 360/Bing 的 HTML，靠正则解析，上游改版会碎）
# 自建 SearXNG 后填这里，auto 模式会优先用它（返回 JSON，更稳）
# SEARXNG_URL=http://127.0.0.1:8080
# SEARCH_BACKEND=auto            # auto | searxng | bing | so

# 可选：覆盖默认路径与版本
# DSH_HOME=/opt/dsh
# NAPCAT_DIR=/opt/qqbot
# NODE_VER=v24.22.0
# DSH_VER=0.2.1-rc.2
# NPM_REG=https://registry.npmmirror.com
# NODE_MIRROR=https://registry.npmmirror.com/-/binary/node

# -- 看图端点（可选，但强烈建议填）--------------------------------
# 她"看图片"走多模态接口。纯文本接口（比如 api.deepseek.com）看不了图。
# 不填的后果：能聊天，但 read_image / 表情分类 / 截图隐私判断全部失败，
# 而且不会报错，只表现为"她说看不到图片"。
# 填一个支持图片输入、兼容 OpenAI 的端点：
#   VISION_BASE=https://your-multimodal-endpoint/v1
#   VISION_MODEL=某个支持图片的模型名
# 留空 = 回落到 LLM_BASE_URL / LLM_MODEL（当它们本身支持看图时最省事）。
VISION_BASE=
VISION_MODEL=
VISION_API_KEY=

# -- 掉线告警邮件（可选）-------------------------------------
# QQ 掉线时出站消息发不出去，邮箱是唯一还通的通道。
# SMTP_PASS 是 QQ 邮箱的「授权码」，不是 QQ 密码。
# 获取：QQ邮箱网页版 -> 设置 -> 账号 -> POP3/IMAP/SMTP 服务 -> 开启 -> 生成授权码
# 不填就没这个功能，其它一切正常。
MAIL_PASS=
MAIL_USER=
MAIL_TO=
